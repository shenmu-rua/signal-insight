# 自动识别文本文件并统一仓库中的换行符
* text=auto

# Python 文件统一 LF 换行符
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Jupyter Notebook
*.ipynb text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.docx binary
*.pptx binary
*.zip binary